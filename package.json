{
  "name": "typesafe-gates",
  "version": "0.1.0",
  "description": "Probabilistic decision gates for LLM pipelines on TypeSafe AI's System One (Jev): typed Score, Choice and yes/no judgments with explicit thresholds, a stated fail-open or fail-closed policy per gate, all-or-nothing batches, time budgets, and usage accounting. Ships six reference gates from production.",
  "license": "MIT",
  "author": "Mike Pointer <mpointer@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpointer/typesafe-gates.git"
  },
  "homepage": "https://github.com/mpointer/typesafe-gates#readme",
  "bugs": "https://github.com/mpointer/typesafe-gates/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./gates": {
      "types": "./dist/gates/index.d.ts",
      "import": "./dist/gates/index.js",
      "default": "./dist/gates/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "eslint .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "typesafe-ai",
    "jev",
    "system-one",
    "llm",
    "guardrails",
    "decision-gate",
    "relevance",
    "prompt-injection",
    "classification",
    "probability",
    "ai-governance"
  ],
  "peerDependencies": {
    "@typesafe-ai/sdk": ">=0.6.0 <1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typesafe-ai/sdk": "0.6.0",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
